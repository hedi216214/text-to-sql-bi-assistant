# Pick one provider. Groq and Mistral have free tiers; Ollama runs locally for free.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b

# Embeddings for retrieving similar examples (RAG). Optional: without EMBED_MODEL,
# a local hashing embedder is used (no download, no key). Groq has no embeddings API.
# EMBED_BASE_URL=https://api.mistral.ai/v1
# EMBED_API_KEY=your_key_here
# EMBED_MODEL=mistral-embed
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_MODEL=nomic-embed-text
